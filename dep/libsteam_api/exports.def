; libsteam_api shim — Windows export surface
;
; The legacy Win32 libsteam_api.dll exports 56 symbols (verified by
; `objdump -p rehlds/lib/steam_api.dll`). We mirror that set here so the
; shim's import lib (steam_api.lib) presents the same shape to MSVC
; consumers. Entries listed in alphabetical order, matching the
; ordinal/name-pointer table emitted by the legacy DLL — keep this
; ordering when adding/removing entries so future ABI diffs stay readable.
;
; g_pSteamClientGameServer is the only data export. The DATA keyword
; tells the linker to emit the import lib stub as a data fixup rather
; than a code thunk; consumers deref the symbol directly.
;
; SteamRealPath is intentionally omitted: the legacy Win32 dll never
; exported it. Linux exports it (via exports.ver) and the .cpp gates
; the implementation under !defined(_WIN32).
;
; SteamUnifiedMessages is omitted for the same reason: not in the legacy
; Win32 export table. The Linux build keeps it (the engine doesn't call
; it but it round-trips through SteamAPI_Init's interface acquisition).

; LIBRARY directive omitted on purpose: the vcxproj's TargetName picks
; the per-arch DLL name (steam_api on Win32, steam_api64 on x64).  With
; LIBRARY hardcoded, the linker embedded that name into the x64 import
; lib's DLL reference, so consumers ended up loading steam_api.dll at
; runtime even though we shipped steam_api64.dll — STATUS_DLL_NOT_FOUND.

EXPORTS
    GetHSteamPipe                                  @1
    GetHSteamUser                                  @2
    SteamAPI_GetHSteamPipe                         @3
    SteamAPI_GetHSteamUser                         @4
    SteamAPI_GetSteamInstallPath                   @5
    SteamAPI_Init                                  @6
    SteamAPI_InitSafe                              @7
    SteamAPI_IsSteamRunning                        @8
    SteamAPI_RegisterCallResult                    @9
    SteamAPI_RegisterCallback                      @10
    SteamAPI_RestartAppIfNecessary                 @11
    SteamAPI_RunCallbacks                          @12
    SteamAPI_SetBreakpadAppID                      @13
    SteamAPI_SetMiniDumpComment                    @14
    SteamAPI_SetTryCatchCallbacks                  @15
    SteamAPI_Shutdown                              @16
    SteamAPI_UnregisterCallResult                  @17
    SteamAPI_UnregisterCallback                    @18
    SteamAPI_UseBreakpadCrashHandler               @19
    SteamAPI_WriteMiniDump                         @20
    SteamApps                                      @21
    SteamClient                                    @22
    SteamContentServer                             @23
    SteamContentServerUtils                        @24
    SteamContentServer_Init                        @25
    SteamContentServer_RunCallbacks                @26
    SteamContentServer_Shutdown                    @27
    SteamFriends                                   @28
    SteamGameServer                                @29
    SteamGameServerApps                            @30
    SteamGameServerHTTP                            @31
    SteamGameServerNetworking                      @32
    SteamGameServerStats                           @33
    SteamGameServerUtils                           @34
    SteamGameServer_BSecure                        @35
    SteamGameServer_GetHSteamPipe                  @36
    SteamGameServer_GetHSteamUser                  @37
    SteamGameServer_GetIPCCallCount                @38
    SteamGameServer_GetSteamID                     @39
    SteamGameServer_Init                           @40
    SteamGameServer_InitSafe                       @41
    SteamGameServer_RunCallbacks                   @42
    SteamGameServer_Shutdown                       @43
    SteamHTTP                                      @44
    SteamMatchmaking                               @45
    SteamMatchmakingServers                        @46
    SteamNetworking                                @47
    SteamRemoteStorage                             @48
    SteamScreenshots                               @49
    SteamUser                                      @50
    SteamUserStats                                 @51
    SteamUtils                                     @52
    Steam_GetHSteamUserCurrent                     @53
    Steam_RegisterInterfaceFuncs                   @54
    Steam_RunCallbacks                             @55
    g_pSteamClientGameServer                       @56 DATA
