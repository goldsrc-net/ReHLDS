# libsteam_api is built from source by dep/libsteam_api/ on every CI run.
# The output paths are tracked locations (downstream link expects them at
# rehlds/lib/${ARCH_LIB_DIR}/libsteam_api.{so,dll}), but the binaries
# themselves are build artifacts and should not be committed.
rehlds/lib/linux32/libsteam_api.so
rehlds/lib/linux64/libsteam_api.so
rehlds/lib/linuxarm64/libsteam_api.so
rehlds/lib/win32/steam_api.dll
rehlds/lib/win32/steam_api.lib
rehlds/lib/win32/steam_api.exp
rehlds/lib/win32/steam_api.pdb
rehlds/lib/win64/steam_api64.dll
rehlds/lib/win64/steam_api64.lib
rehlds/lib/win64/steam_api64.exp
rehlds/lib/win64/steam_api64.pdb
# MSVC intermediate build outputs from the libsteam_api project.
dep/libsteam_api/msvc/build/
*.iml
*.bat
*.log
*.lnk
*.aps
